# Public browser-safe values only. Never prefix a service-role key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
# New projects use a publishable key. The legacy anon key is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only and scoped to trusted Billing mutations. Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=

# Public application origin, without a trailing slash.
# In Vercel Preview/Staging, set this to the exact HTTPS staging deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development-only no-Docker fixture workspace. The application ignores this in production.
PPERFIL_DEMO_MODE=false

# Development-only visual comparison route. NODE_ENV=production always disables it.
PPERFIL_TEMPLATE_LAB=false

# Server-only Stripe Billing provider. Local and Preview must use TEST.
# Prefer rk_test_ restricted credentials; sk_test_ is accepted temporarily.
STRIPE_ENVIRONMENT=TEST
STRIPE_API_KEY=
# Optional safety pin; recommended before deployment.
STRIPE_ACCOUNT_ID=
# Catalog objects are created and approved in Billing 1C, not automatically.
STRIPE_PRO_BR_MONTHLY_LOOKUP_KEY=pperfil_pro_br_monthly
STRIPE_PRO_PRODUCT_ID=
# Server-only signing secret for this environment's Stripe webhook endpoint.
STRIPE_WEBHOOK_SECRET=

# Server-only transactional email delivery. Until a branded domain is verified,
# EMAIL_FROM may use the Resend test-safe sender: PPerfil <onboarding@resend.dev>.
RESEND_API_KEY=
EMAIL_FROM="PPerfil <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# Server-only workout Draft generation. Manual workout creation remains available
# when these values are absent. Never expose the API key with NEXT_PUBLIC_.
WORKOUT_AI_PROVIDER=openai
WORKOUT_AI_API_KEY=
WORKOUT_AI_MODEL=
WORKOUT_AI_BASE_URL=https://api.openai.com/v1
WORKOUT_AI_TIMEOUT_MS=25000
