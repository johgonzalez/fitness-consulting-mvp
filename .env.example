# Public browser-safe values only. Never prefix a service-role key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
# New projects use a publishable key. The legacy anon key is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public application origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Development-only no-Docker fixture workspace. The application ignores this in production.
PPERFIL_DEMO_MODE=false
